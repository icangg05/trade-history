{"nodes": [{"id": "rancangan_trade_history", "label": "Trade History (jurnal trading pribadi)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single user, multi-akun; karena hanya satu pengguna banyak hal sengaja disederhanakan (tanpa queue, Redis, websocket, state manager)."}, {"id": "rancangan_laravel_13", "label": "Laravel 13 monolith", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Monolith tanpa API terpisah \u2014 Inertia menghapus kebutuhan API layer."}, {"id": "rancangan_inertia_vue", "label": "Inertia v3 + Vue 3 (script setup, TS)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tanpa router atau state manager sendiri; routing dan state tetap di server."}, {"id": "rancangan_tailwind_v4", "label": "Tailwind CSS v4 (CSS-first)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSS-first: tidak ada tailwind.config.js, token didefinisikan di app.css."}, {"id": "rancangan_shadcn_vue", "label": "shadcn-vue (reka-ui)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rancangan_frankenphp_octane", "label": "FrankenPHP + Laravel Octane (worker mode)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Satu container serve HTTP+PHP. Konsekuensi: hindari state di properti singleton, AccountStats harus stateless."}, {"id": "rancangan_mysql_84", "label": "MySQL 8.4", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rancangan_vite_8", "label": "Vite 8 (rolldown)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71, \u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Butuh registerTS + script.fs di vite.config.ts agar compiler SFC bisa membaca tipe props dari reka-ui."}, {"id": "rancangan_gemini_api", "label": "Gemini API (gemini-3.5-flash)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71, \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dipanggil lewat HTTP client Laravel langsung ke REST API \u2014 tidak perlu SDK."}, {"id": "rancangan_dark_only_theme", "label": "Tema dark-only", "file_type": "rationale", "source_file": "RANCANGAN.md", "source_location": "\u00a71, \u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tidak ada toggle dan tidak ada class .dark; varian dark: shadcn dibuat selalu aktif lewat @custom-variant dark (&). Satu tema menghapus seluruh percabangan palet."}, {"id": "rancangan_pwa", "label": "PWA (manifest + service worker tulis tangan)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a71, \u00a79, \u00a712", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dipakai dari HP sambil trading sehingga harus bisa dipasang di home screen; hanya aset ber-hash yang di-cache supaya tidak ada halaman basi."}, {"id": "rancangan_design_tokens", "label": "Token warna nfp dark di-flatten ke :root", "file_type": "rationale", "source_file": "RANCANGAN.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hanya blok .dark dari project nfp yang diambil lalu di-flatten; tidak ada prefers-color-scheme."}, {"id": "rancangan_glass_utilities", "label": "Utilities .glass / ornamen / hover-lift", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rancangan_semantic_color_rules", "label": "Aturan warna semantik (gold / success / destructive / cyan)", "file_type": "rationale", "source_file": "RANCANGAN.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gold dikhususkan untuk aksi utama dan brand, bukan profit, supaya hijau/merah tetap hanya berarti P/L."}, {"id": "rancangan_typography_mono", "label": "IBM Plex Mono + tabular-nums untuk angka", "file_type": "rationale", "source_file": "RANCANGAN.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semua angka uang/harga pakai font mono agar kolom tabel rata."}, {"id": "rancangan_accounts_table", "label": "Tabel accounts", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rancangan_transactions_table", "label": "Tabel transactions (deposit/withdrawal)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "proof_path nullable di DB hanya supaya seeder valid; lewat form bukti transfer wajib."}, {"id": "rancangan_trades_table", "label": "Tabel trades", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pnl null berarti posisi masih open; status dan rr_planned diturunkan saat simpan, bukan diinput."}, {"id": "rancangan_account_rules_table", "label": "Tabel account_rules (kolom eksplisit, 1:1 akun)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kolom eksplisit dipilih daripada key-value supaya bisa dihitung langsung di SQL."}, {"id": "rancangan_ai_analyses_table", "label": "Tabel ai_analyses (cache hasil Gemini)", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a74, \u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique (account_id, stats_hash) supaya statistik yang sama tidak dibayar dua kali ke Gemini."}, {"id": "rancangan_no_balance_snapshot", "label": "Tanpa tabel ledger/snapshot saldo", "file_type": "rationale", "source_file": "RANCANGAN.md", "source_location": "\u00a74, \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saldo = initial_balance + \u03a3deposit \u2212 \u03a3withdrawal + \u03a3pnl(closed), dihitung on-the-fly lewat UNION ALL + running sum. Untuk skala pribadi (ribuan baris) instan; snapshot ditambahkan hanya kalau terbukti lambat."}, {"id": "rancangan_accountstats", "label": "App\\Services\\AccountStats", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a73, \u00a76.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Semua agregasi & equity curve di satu tempat, dibuat stateless karena Octane worker mode."}, {"id": "rancangan_gemini_service", "label": "App\\Services\\Gemini", "file_type": "concept", "source_file": "RANCANGAN.md", "source_location": "\u00a73, \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Satu file dua method; HTTP client Laravel langsung ke REST API, tanpa SDK."}, {"id": "rancangan_extracttrade", "label": "Gemini::